  <!-- ══════════════════════════════════════════════
       CONTACT FORM + INFO
  ══════════════════════════════════════════════ -->
  <section class="contact-section">
    <div class="inner">
      <div class="contact-grid">

        <!-- ── INQUIRY FORM ── -->
        <div class="form-card reveal">
          <h2 class="form-card-title">Send an Inquiry</h2>
          <p class="form-card-sub">Fill out the form below and our team will respond within 24 hours.</p>

          <form id="contact-form" action="mailto:info@syntrixph.com" method="post" enctype="text/plain" novalidate>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="f-name">Full Name <span class="req">*</span></label>
                <input class="form-input" type="text" id="f-name" name="name" placeholder="Juan dela Cruz" autocomplete="name" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="f-email">Email Address <span class="req">*</span></label>
                <input class="form-input" type="email" id="f-email" name="email" placeholder="juan@email.com" autocomplete="email" required />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="f-phone">Phone / Viber</label>
                <input class="form-input" type="tel" id="f-phone" name="phone" placeholder="+63 917 000 0000" autocomplete="tel" />
              </div>
              <div class="form-group">
                <label class="form-label" for="f-persons">Number of Persons <span class="req">*</span></label>
                <input class="form-input" type="number" id="f-persons" name="persons" placeholder="e.g. 4" min="1" max="50" required />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="f-tour-type">Tour Type <span class="req">*</span></label>
                <select class="form-select" id="f-tour-type" name="tour_type" required>
                  <option value="" disabled selected>Select tour type</option>
                  <option value="private">Private Tour</option>
                  <option value="joiner">Joiner Package</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="f-destination">Destination</label>
                <select class="form-select" id="f-destination" name="destination">
                  <option value="" disabled selected>Choose destination</option>
                  <option value="cebu">Cebu</option>
                  <option value="bohol">Bohol</option>
                  <option value="both">Cebu + Bohol</option>
                  <option value="undecided">Not sure yet</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="f-package">Selected Package</label>
              <input class="form-input" type="text" id="f-package" name="package" placeholder="Package selected from details" readonly />
            </div>

            <div class="form-group">
              <label class="form-label" for="f-date">Preferred Travel Date</label>
              <input class="form-input" type="date" id="f-date" name="date" />
            </div>

            <div class="form-group">
              <label class="form-label" for="f-message">Message</label>
              <textarea class="form-textarea" id="f-message" name="message" placeholder="Tell us more about your trip, special requests, or any questions you have…"></textarea>
            </div>

            <button class="form-submit" type="submit" id="btn-submit">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              Send Inquiry
            </button>

            <p class="form-feedback" id="form-feedback" aria-live="polite"></p>
          </form>
        </div>


        <!-- ── CONTACT INFO ── -->
        <div class="info-card reveal reveal-delay-2">
          <h3 class="info-card-title">Contact Information</h3>

          <div class="info-item">
            <div class="info-icon">📍</div>
            <div class="info-detail">
              <strong>Address</strong>
              <p>Sitio Capilis, Subabasbas, Lapu-Lapu, 6015 Cebu</p>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon">📞</div>
            <div class="info-detail">
              <strong>Phone / Viber</strong>
              <ul><a href="tel:+639209851802">+63 9209851802</a></ul>
              <ul><a href="tel:+639175550793">+63 9175550793</a></ul>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon">📧</div>
            <div class="info-detail">
              <strong>Email</strong>
              <a href="mailto:info@syntrixph.com">info@syntrixph.com</a>
            </div>
          </div>

          <a href="https://www.facebook.com/ESHappyTours" target="_blank" rel="noopener noreferrer" class="btn-facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            Message us on Facebook
