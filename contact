          <div class="hours-card">
            <h4>Office Hours</h4>
            <div class="hours-row">
              <span class="hours-days">Monday – Friday</span>
              <span class="hours-time">8:00 AM – 6:00 PM</span>
            </div>
            <div class="hours-row">
              <span class="hours-days">Saturday</span>
              <span class="hours-time">8:00 AM – 5:00 PM</span>
            </div>
            <div class="hours-row">
              <span class="hours-days">Sunday</span>
              <span class="hours-time">9:00 AM – 3:00 PM</span>
            </div>
          </div>
        </div>

      </div>
    </div>
